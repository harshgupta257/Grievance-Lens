# Copy to .env and change the password:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real credentials.

# Used by docker-compose.yml to create the database, and by src/config.py to build the connection URL.
POSTGRES_USER=cpgrams
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cpgrams
POSTGRES_HOST=127.0.0.1
# Host port published by Docker. Change it if 5432 is already taken on your machine.
POSTGRES_HOST_PORT=5432

# Optional: a full SQLAlchemy URL overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg2://cpgrams:change_me@127.0.0.1:5432/cpgrams

# Optional, opt-in: enables the integration tests. They create and drop a temporary schema,
# so pointing this at the same development database is safe.
# TEST_DATABASE_URL=postgresql+psycopg2://cpgrams:change_me@127.0.0.1:5432/cpgrams

# --- Complaint router (Phase 9). Everything below is optional: without it the router runs offline
# (retrieval + rules), and analytics and the standard tests never need an API key.
# LLM_PROVIDER=anthropic             # none (default) | anthropic
# ANTHROPIC_API_KEY=your-key-here    # or run `ant auth login`; the Anthropic SDK finds the credential
# LLM_MODEL=claude-opus-5-5          # the only model called (no silent fallback to a different model)
# LLM_EFFORT=low                     # low | medium | high | xhigh | max
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2
# LLM_REFUSAL_FALLBACK=true          # server-side fallback on a policy refusal (fallbacks: "default")
# LLM_MAX_CALLS_PER_PROCESS=500      # hard cap on paid calls per process
# LLM_INPUT_PRICE_PER_MTOK=4.0       # USD, used only for the cost estimate in the usage log
# LLM_OUTPUT_PRICE_PER_MTOK=20.0
# ROUTER_RETRIEVAL=lexical           # lexical (default) | hybrid (needs requirements-embeddings.txt)
