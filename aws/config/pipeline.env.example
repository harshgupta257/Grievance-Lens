# Settings for the AWS pipeline scripts. Copy to aws/config/pipeline.env (git-ignored) and fill in.
# PLACEHOLDERS ONLY: never put access keys or secrets here. Authenticate with `aws configure sso`
# (IAM Identity Center) and select the profile with AWS_PROFILE.
AWS_PROFILE=grievance-lens
GL_REGION=ap-south-1
# Globally unique bucket name you choose, e.g. grievance-lens-<your-initials>-<random-suffix>
GL_BUCKET=
GL_GLUE_JOB=grievance-lens-etl
GL_ATHENA_WORKGROUP=grievance-lens
# Only if you deploy Redshift Serverless (deploy.py --with-redshift):
GL_REDSHIFT_WORKGROUP=grievance-lens-wg
GL_REDSHIFT_DATABASE=dev
# arn:aws:iam::<account-id>:role/grievance-lens-redshift-copy
GL_REDSHIFT_ROLE_ARN=
