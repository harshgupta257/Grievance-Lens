{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "UploadBatchesAndReadResults", "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"],
     "Resource": ["arn:aws:s3:::${BUCKET}/raw/powerbi/*", "arn:aws:s3:::${BUCKET}/athena-results/*"]},
    {"Sid": "ReadControl", "Effect": "Allow", "Action": "s3:GetObject",
     "Resource": ["arn:aws:s3:::${BUCKET}/control/*", "arn:aws:s3:::${BUCKET}/curated/*", "arn:aws:s3:::${BUCKET}/raw/*"]},
    {"Sid": "WarehouseLock", "Effect": "Allow", "Action": ["s3:PutObject", "s3:DeleteObject"],
     "Resource": "arn:aws:s3:::${BUCKET}/control/warehouse/*"},
    {"Sid": "ListBucket", "Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
     "Resource": "arn:aws:s3:::${BUCKET}"},
    {"Sid": "RunEtlManually", "Effect": "Allow", "Action": ["glue:StartJobRun", "glue:GetJobRun", "glue:GetJobRuns"],
     "Resource": "arn:aws:glue:${REGION}:${ACCOUNT_ID}:job/${GLUE_JOB_NAME}"},
    {"Sid": "QueryWithAthena", "Effect": "Allow",
     "Action": ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults",
                "athena:StopQueryExecution", "athena:GetWorkGroup"],
     "Resource": "arn:aws:athena:${REGION}:${ACCOUNT_ID}:workgroup/${ATHENA_WORKGROUP}"},
    {"Sid": "CatalogForAthena", "Effect": "Allow",
     "Action": ["glue:GetDatabase", "glue:GetDatabases", "glue:GetTable", "glue:GetTables", "glue:GetPartitions",
                "glue:CreateDatabase", "glue:CreateTable", "glue:UpdateTable", "glue:DeleteTable"],
     "Resource": ["arn:aws:glue:${REGION}:${ACCOUNT_ID}:catalog",
                  "arn:aws:glue:${REGION}:${ACCOUNT_ID}:database/${GLUE_DATABASE}",
                  "arn:aws:glue:${REGION}:${ACCOUNT_ID}:table/${GLUE_DATABASE}/*",
                  "arn:aws:glue:${REGION}:${ACCOUNT_ID}:database/${GLUE_DATABASE}_raw",
                  "arn:aws:glue:${REGION}:${ACCOUNT_ID}:table/${GLUE_DATABASE}_raw/*"]},
    {"Sid": "RefreshWarehouse", "Effect": "Allow",
     "Action": ["redshift-data:ExecuteStatement", "redshift-data:BatchExecuteStatement"],
     "Resource": "arn:aws:redshift-serverless:${REGION}:${ACCOUNT_ID}:workgroup/*"},
    {"Sid": "WarehouseStatementResults", "Effect": "Allow",
     "Action": ["redshift-data:DescribeStatement", "redshift-data:GetStatementResult"], "Resource": "*",
     "Condition": {"StringEquals": {"redshift-data:statement-owner-iam-userid": "${aws:userid}"}}},
    {"Sid": "WarehouseCredentials", "Effect": "Allow", "Action": "redshift-serverless:GetCredentials",
     "Resource": "arn:aws:redshift-serverless:${REGION}:${ACCOUNT_ID}:workgroup/*"}
  ]
}
