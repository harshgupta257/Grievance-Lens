{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ListCurated", "Effect": "Allow", "Action": "s3:ListBucket",
     "Resource": "arn:aws:s3:::${BUCKET}",
     "Condition": {"StringLike": {"s3:prefix": ["curated/*", "control/redshift_manifests/*"]}}},
    {"Sid": "ReadCuratedParquetAndManifests", "Effect": "Allow", "Action": "s3:GetObject",
     "Resource": ["arn:aws:s3:::${BUCKET}/curated/*", "arn:aws:s3:::${BUCKET}/control/redshift_manifests/*"]}
  ]
}
